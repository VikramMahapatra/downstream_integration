# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
# Callers must send this as the X-API-Key header
SERVICE_API_KEY=change-me

# ---- Database ----
# Postgres in prod:  postgresql+asyncpg://user:pass@localhost:5432/integration_hub
DATABASE_URL=sqlite+aiosqlite:///./integration_hub.db

# ---- Secret encryption ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=z0fbsUncrV8Ph1IFLXwXldQcDOLRwPZ-DKLJbF8eN7M=

# ---- Scheduler ----
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30

# ---- Zoho CRM ----
# Created at https://api-console.zoho.<dc>  ("Server-based Applications")
ZOHO_CLIENT_ID=1000.UYIHQMU6A1N8KRG2IAX6J8MCSAGYDN
ZOHO_CLIENT_SECRET=0c3e80754bb36837e36b22d9a4bb9a6a3344fd90e7
# Must exactly match the redirect URI registered in the Zoho API console
ZOHO_REDIRECT_URI=http://localhost:8000/v1/oauth/zoho_crm/callback
# Data centre: com | eu | in | com.au | jp | ca | com.cn | sa
ZOHO_DEFAULT_DC=in
ZOHO_API_VERSION=v8
# Shared secret echoed back in Zoho notification payloads (you choose the value)
ZOHO_WEBHOOK_TOKEN=
